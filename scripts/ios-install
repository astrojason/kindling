#!/usr/bin/env bash
# Builds the mobile app in Release (standalone JS bundle, no Metro needed) and
# installs it on a connected iPhone or iPad. Uses this machine's Xcode, not EAS cloud.
#
# Usage: scripts/ios-install [iPhone|iPad] [device name or UDID]   (device type defaults to iPhone)
# With no argument, Expo asks which connected device to use.
#
# Needs: the phone connected (or on the same network) with Developer Mode on and
# trusted, Xcode signed in to your Apple Developer team, and apps/mobile/.env.local
# with the EXPO_PUBLIC_* values (API base URL must be the deployed site, not localhost).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MOBILE_DIR="$REPO_ROOT/apps/mobile"
cd "$MOBILE_DIR"

if [[ ! -f .env.local && ! -f .env.production ]]; then
  echo "error: apps/mobile/.env.local not found (see .env.local.example); the app would crash at launch without its Firebase config." >&2
  exit 1
fi
if grep -Eq '^EXPO_PUBLIC_API_BASE_URL=.*(localhost|127\.0\.0\.1)' .env.local 2>/dev/null; then
  echo "error: EXPO_PUBLIC_API_BASE_URL in .env.local points at localhost; a phone can't reach that." >&2
  exit 1
fi

echo "==> Installing dependencies"
(cd "$REPO_ROOT" && npm install)

# ios/ is a generated, gitignored folder; regenerate it so icons, splash and native config match app.json and assets/.
echo "==> Regenerating the native iOS project"
npx expo prebuild --platform ios --clean

KIND="iPhone"
if [[ "${1:-}" == "iPhone" || "${1:-}" == "iPad" ]]; then
  KIND="$1"
  shift
fi
DEVICE="${1:-}"
if [[ -z "$DEVICE" ]]; then
  # No prompt is possible in a non-interactive shell, so pick the device ourselves when exactly one $KIND is available.
  LIST="$(mktemp)"
  xcrun devicectl list devices --json-output "$LIST" >/dev/null 2>&1 || true
  NAMES="$(python3 - "$LIST" "$KIND" <<'PY'
import json, sys
try:
    devices = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    devices = []
for d in devices:
    hw = d.get("hardwareProperties", {})
    if hw.get("deviceType") == sys.argv[2] and hw.get("reality") == "physical" and d.get("connectionProperties", {}).get("pairingState") == "paired":
        print(d["deviceProperties"]["name"])
PY
)"
  rm -f "$LIST"
  COUNT="$(printf '%s' "$NAMES" | grep -c . || true)"
  if [[ "$COUNT" == "1" ]]; then
    DEVICE="$NAMES"
  elif [[ "$COUNT" == "0" ]]; then
    echo "error: no paired $KIND found. Connect and unlock it (Developer Mode on), or pass its name: scripts/ios-install $KIND \"My $KIND\"" >&2
    exit 1
  else
    echo "error: several ${KIND}s found; pass one by name: scripts/ios-install $KIND \"<name>\"" >&2
    printf '%s\n' "$NAMES" >&2
    exit 1
  fi
fi

echo "==> Building a Release build and installing it on: $DEVICE"
npx expo run:ios --device "$DEVICE" --configuration Release
echo "==> Done. If the app won't open, trust your developer certificate in Settings > General > VPN & Device Management."
