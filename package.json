{
  "name": "random-knowledge.astrojason.com",
  "version": "1.28.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "mobile": "npm --prefix apps/mobile run start",
    "icons": "node scripts/icons/generate.mjs",
    "build:web": "npm --prefix apps/web run build",
    "build:ios": "bash scripts/mobile-build ios",
    "build:android": "bash scripts/mobile-build android",
    "build:all": "npm run build:web && npm run build:ios",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck"
  }
}
