# Firebase web app config — from `firebase apps:sdkconfig WEB <APP_ID>` (setup-plan.md step 4).
# Safe to expose client-side by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Superadmin access is a Firebase Auth custom claim, not an env var — after
# deploying, bootstrap it by email:
#   npm run grant-superadmin -- you@example.com

# Server-side only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Must support Responses API web_search; used to gather cited evidence before writing.
OPENAI_RESEARCH_MODEL=gpt-4.1

# Firebase Admin service account JSON, as a single-line string, used by
# src/lib/firebase-admin.ts to verify ID tokens in /api/generate-lesson.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Migration scripts only (read-only source projects; never used by the app, never set in
# production): the old random-knowledge-ea232 and commonbook recall-4899d projects.
# Delete these once the Kindling migration is done and the old projects are removed.
FIREBASE_SERVICE_ACCOUNT_KEY_RANDOM_KNOWLEDGE=
FIREBASE_SERVICE_ACCOUNT_KEY_COMMON_BOOK=
# The owner's Firebase Auth UID in each old project (migration scripts only). They differ, so
# the migration needs to know both to merge one person's data into a single Kindling account.
RANDOM_KNOWLEDGE_UID=
COMMON_BOOK_UID=
# The owner's UID in the new Kindling project: both old UIDs above are re-keyed onto this one.
KINDLING_UID=

# Cloned-voice narration (src/lib/elevenlabs.ts). Without these, ReadAloudButton
# silently falls back to the browser's built-in speechSynthesis voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
